#!/bin/bash
#     __ _   _
#    / _| |_| |_ ___
#   | |_| __| __/ __|
#   |  _| |_| |_\__ \
#   |_|  \__|\__|___/
#
# ftts - A professional text-to-speech engine wrapper for Festival, with
#        optional MP3 saving and a choice of live playback engine.
#
# Project: https://github.com/galaxy-cli/ftts

# --- PROGRAM CONFIGURATION ---
PROGRAM_NAME="${0##*/}"
VERSION="3.0.0"

# --- USAGE ---
usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]... [FILE | TEXT]

Convert text files, strings, and clipboards to speech fluidly.

Mandatory arguments to long options are mandatory for short options too.
  -c, --clipboard        read text directly from the system clipboard
  -f, --file=FILE        read text from specified plaintext FILE
  -s, --say=TEXT         speak the provided quoted string of TEXT
  -p, --player=PLAYER    playback engine: 'aplay' (default) or 'mpv'
  -o, --output=DIR       also save an MP3 copy into DIR (auto-named)
      --help             display this help and exit
  -v, --version          output version information and exit

Examples:
  ${PROGRAM_NAME} -c
  ${PROGRAM_NAME} -f notes.txt -o ~/Documents
  ${PROGRAM_NAME} -s "Hello world" -p mpv

Report bugs to: <https://github.com/galaxy-cli/ftts/issues>
EOF
}

# --- VERSION ---
show_version() {
    cat <<EOF
${PROGRAM_NAME} ${VERSION}
EOF
}

# --- DEPENDENCY HELPERS ---
# Maps a command to its installable apt package, for the rare cases where
# they differ -- e.g. 'aplay' ships in the 'alsa-utils' package, not one
# literally called 'aplay', so installing "aplay" directly via apt fails.
pkg_for() {
    case "$1" in
        aplay) echo "alsa-utils" ;;
        *) echo "$1" ;;
    esac
}

# Checked contextually, right before each capability is actually needed
# (after argument parsing, so --help/--version never trigger a dependency
# prompt), rather than every possible command unconditionally at startup.
check_deps() {
    local missing_cmds=() missing_pkgs=()
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing_cmds+=("$cmd")
            missing_pkgs+=("$(pkg_for "$cmd")")
        fi
    done

    if [ "${#missing_cmds[@]}" -gt 0 ]; then
        echo "${PROGRAM_NAME}: missing required dependencies: ${missing_cmds[*]}" >&2
        read -rp "Would you like to install them via apt? [Y/n] " yn
        yn=${yn:-Y}

        if [[ $yn =~ ^[Yy]$ ]]; then
            sudo apt install -y "${missing_pkgs[@]}"
        else
            echo "${PROGRAM_NAME}: cannot continue without required dependencies" >&2
            exit 1
        fi
    fi
}

# --- OUTPUT NAMING HELPERS ---
# Lowercases, collapses whitespace, keeps the first ~6 words, and strips
# anything that isn't alphanumeric -- used to build a recognizable filename
# out of clipboard/string input, which has no natural name of its own.
slugify_prefix() {
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -s '[:space:]' ' ' \
        | cut -d' ' -f1-6 \
        | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
        | cut -c1-50
}

# Computes the final save path inside $output_dir: the source filename for
# file input, or a content-slug + timestamp for clipboard/string input
# (which has no name to borrow). Auto-disambiguates with a numeric suffix
# instead of silently overwriting an existing file of the same name.
compute_output_path() {
    local base=""
    case "$input_source" in
        file)
            base=$(basename "$file_path")
            base="${base%.*}"
            [[ -z "$base" ]] && base="audio"
            ;;
        clipboard|string)
            local slug stamp
            slug=$(slugify_prefix "$text")
            stamp=$(date +%Y%m%d-%H%M%S)
            base="${slug:-ftts}_${stamp}"
            ;;
    esac

    local candidate="${output_dir%/}/${base}.mp3"
    local n=2
    while [[ -e "$candidate" ]]; do
        candidate="${output_dir%/}/${base}_${n}.mp3"
        ((n++))
    done
    printf '%s' "$candidate"
}

# --- INITIALIZE ---
input_source=""
file_path=""
output_dir=""
output_file=""
player="aplay"
text=""
mpv_fifo=""
mpv_pid=""

# --- ARGUMENT PARSING ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clipboard)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            input_source="clipboard"
            shift
            ;;
        -f|--file)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'f'" >&2; exit 1; }
            input_source="file"
            file_path="$2"
            shift 2
            ;;
        -s|--say)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 's'" >&2; exit 1; }
            input_source="string"
            text="$2"
            shift 2
            ;;
        -p|--player)
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'p'" >&2; exit 1; }
            case "$2" in
                aplay|mpv) player="$2" ;;
                *) echo "${PROGRAM_NAME}: invalid player '$2' (expected 'aplay' or 'mpv')" >&2; exit 1 ;;
            esac
            shift 2
            ;;
        -o|--output)
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'o'" >&2; exit 1; }
            output_dir="$2"
            shift 2
            ;;
        --help)
            usage
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -*)
            echo "${PROGRAM_NAME}: unrecognized option '$1'" >&2
            echo "Try '${PROGRAM_NAME} --help' for more information" >&2
            exit 1
            ;;
        *)
            if [[ -n "$text" ]]; then
                echo "${PROGRAM_NAME}: multi-word strings must be enclosed in double quotes" >&2
                echo "Try '${PROGRAM_NAME} -s \"hello world\"'" >&2
                exit 1
            fi
            echo "${PROGRAM_NAME}: extra operand '$1'" >&2
            echo "Try '${PROGRAM_NAME} --help' for more information" >&2
            exit 1
            ;;
    esac
done

# --- VALIDATION ---
if [[ -z "$input_source" ]]; then
    echo "${PROGRAM_NAME}: no input source specified" >&2
    echo "Try '${PROGRAM_NAME} --help' for more information" >&2
    exit 1
fi

# --- CORE DEPENDENCIES ---
# festival (synthesis) is needed for every mode; the playback dependency
# depends on which player was selected.
check_deps festival
if [[ "$player" == "mpv" ]]; then
    check_deps mpv
else
    check_deps aplay
fi

if [[ "$input_source" == "clipboard" ]]; then
    check_deps xsel
fi

if [[ "$input_source" == "file" ]]; then
    check_deps file

    if [[ ! -e "$file_path" ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: No such file or directory" >&2
        exit 1
    elif [[ ! -f "$file_path" ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: Not a regular file" >&2
        exit 1
    elif [[ ! -r "$file_path" ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: Permission denied" >&2
        exit 1
    fi

    if [[ "$file_path" == *.pdf ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: PDF files are not supported natively" >&2
        echo "Please open the file, copy the desired text, and use '${PROGRAM_NAME} -c' instead" >&2
        exit 1
    elif [[ $(file -b --mime-type "$file_path") != text/* ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: Not a plaintext document file" >&2
        exit 1
    fi
fi

# --- OUTPUT DIRECTORY VALIDATION ---
# -o now takes a destination DIRECTORY, not an exact file path -- the
# actual filename is derived later (once the text is known, for the
# clipboard/string slug) via compute_output_path().
if [[ -n "$output_dir" ]]; then
    if [[ ! -d "$output_dir" ]]; then
        echo "${PROGRAM_NAME}: ${output_dir}: No such directory" >&2
        exit 1
    elif [[ ! -w "$output_dir" ]]; then
        echo "${PROGRAM_NAME}: ${output_dir}: Permission denied" >&2
        exit 1
    fi
fi

# lame is needed whenever we're saving a copy, AND whenever mpv is the
# player -- mpv streaming always lame-encodes each segment as the transport
# format for the FIFO below, independent of whether -o was also given.
if [[ -n "$output_dir" || "$player" == "mpv" ]]; then
    check_deps lame
fi

# --- DATA EXTRACTION ---
case "$input_source" in
    clipboard)
        text="$(xsel -b 2>/dev/null)"
        if [[ -z "${text//[[:space:]]/}" ]]; then
            echo "${PROGRAM_NAME}: clipboard is empty" >&2
            exit 1
        fi
        ;;
    file)
        text="$(cat "$file_path")"
        if [[ -z "${text//[[:space:]]/}" ]]; then
            echo "${PROGRAM_NAME}: ${file_path}: File is empty" >&2
            exit 1
        fi
        ;;
    string)
        ;;
    *)
        echo "${PROGRAM_NAME}: invalid internal input configuration" >&2
        exit 1
        ;;
esac

# --- RESOLVE SAVE PATH (now that $text/$file_path are known) ---
if [[ -n "$output_dir" ]]; then
    output_file=$(compute_output_path)
    > "$output_file"
fi

# --- COMPONENT SETUP ---
wav_segment=$(mktemp /tmp/ftts_seg.XXXXXX.wav)
scm_script=$(mktemp /tmp/ftts_exec.XXXXXX.scm)

# --- CLEAN EXIT TRAP ---
cleanup() {
    # Single pattern with alternation -- pkill only accepts one pattern
    # argument, so passing these as three separate arguments would be
    # rejected and silently do nothing.
    pkill -P $$ 'festival|lame|aplay' 2>/dev/null
    [[ -n "$mpv_pid" ]] && kill "$mpv_pid" 2>/dev/null
    rm -f "$wav_segment" "$scm_script" 2>/dev/null
    [[ -n "$mpv_fifo" ]] && rm -f "$mpv_fifo" 2>/dev/null
}
trap 'cleanup; echo -e "\n[Speech Interrupted]"; exit 0' SIGINT SIGTERM
trap 'cleanup' EXIT

# --- MPV STREAMING SETUP ---
# mpv is heavier to start than aplay, so (unlike aplay, which is launched
# fresh per sentence below) it's started exactly ONCE here and fed a
# continuous stream over a FIFO. File descriptor 3 is held open for
# writing for the entire loop below, specifically so mpv never sees a
# premature EOF between sentences: a FIFO reports EOF once ALL writers
# close, and each sentence's own 'lame' process opening/closing the FIFO
# individually would cause mpv to see (and act on) an EOF after every
# single sentence otherwise.
if [[ "$player" == "mpv" ]]; then
    mpv_fifo=$(mktemp -u /tmp/ftts_stream.XXXXXX.fifo)
    mkfifo "$mpv_fifo"
    mpv --no-terminal --really-quiet "$mpv_fifo" &
    mpv_pid=$!
    exec 3> "$mpv_fifo"
fi

# --- STREAMED SENTENCE EXECUTION ---
while read -r sentence; do
    [[ -z "${sentence//[[:space:]]/}" ]] && continue

    # Double escape backslashes and escape quotes safely for Scheme syntax
    escaped_sentence=$(printf '%s' "$sentence" | sed 's/\\/\\\\/g; s/"/\\"/g')

    # Generate an explicit Scheme file dynamically
    cat <<EOF > "$scm_script"
(Parameter.set 'Duration_Stretch 0.7)
(set! myutt (Utterance Text "${escaped_sentence}"))
(utt.synth myutt)
(utt.save.wave myutt "${wav_segment}")
EOF

    # Execute Festival and catch stderr to a variable to evaluate errors
    festival_errors=$(festival -b "$scm_script" 2>&1 >/dev/null)
    festival_status=$?

    # --- ERROR HANDLING ENGINE ---
    if [ $festival_status -ne 0 ] || [ ! -s "$wav_segment" ]; then
        echo -e "\n[!] Festival Error Detected (Exit Code: $festival_status)" >&2
        if [[ -n "$festival_errors" ]]; then
            echo "Details: $(echo "$festival_errors" | head -n 2)" >&2
        fi
        echo "Problematic Text: \"$sentence\"" >&2
        echo "Skipping sentence segment to prevent script crash..." >&2
        rm -f "$wav_segment" 2>/dev/null
        continue
    fi

    # --- AUDIO PLAYBACK & SAVE ---
    if [[ -f "$wav_segment" && -s "$wav_segment" ]]; then
        if [[ "$player" == "mpv" ]]; then
            if [[ -n "$output_file" ]]; then
                lame --preset standard "$wav_segment" - 2>/dev/null | tee -a "$output_file" >&3
            else
                lame --preset standard "$wav_segment" - 2>/dev/null >&3
            fi
        else
            # Unchanged from before: aplay per sentence, backgrounded
            # alongside the lame encode when also saving so playback and
            # encoding happen concurrently rather than one after another.
            if [[ -n "$output_file" ]]; then
                aplay "$wav_segment" 2>/dev/null &
                APLAY_PID=$!
                lame --preset standard "$wav_segment" - >> "$output_file" 2>/dev/null
                wait $APLAY_PID 2>/dev/null
            else
                aplay "$wav_segment" 2>/dev/null
            fi
        fi
        rm -f "$wav_segment"
    fi
done < <(printf '%s\n' "$text" | awk 'BEGIN { RS="[ \t\n]+" ; len=0 } { printf "%s ", $0; len+=length($0)+1; if ($0 ~ /[.?!]["\x27\x22]*$/ || len > 150) { printf "\n"; len=0 } } END { printf "\n" }')

# Closing fd 3 is what lets mpv's reader finally see EOF and finish up
# cleanly once every sentence has actually been written, then wait for it
# so the script (and its EXIT trap) doesn't tear mpv down mid-playback.
if [[ "$player" == "mpv" ]]; then
    exec 3>&-
    wait "$mpv_pid" 2>/dev/null
fi

if [[ -n "$output_file" ]]; then
    echo "${PROGRAM_NAME}: saved to ${output_file}" >&2
fi
