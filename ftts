#!/usr/bin/env bash
#     __ _   _
#    / _| |_| |_ ___
#   | |_| __| __/ __|
#   |  _| |_| |_\__ \
#   |_|  \__|\__|___/
#
# ftts - A professional text-to-speech engine wrapper for Festival, with
#        optional MP3 saving and an optional mpv playback mode.
#
# Project: https://github.com/galaxy-cli/ftts

set -uo pipefail

PROGRAM_NAME="${0##*/}"
VERSION="4.0.0"

usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]...

Convert text from files, clipboard, arguments, or stdin into speech via aplay.

Input:
  -c, --clipboard       read text from the system clipboard
  -f, --file=FILE       read text from a plaintext file
  -s, --say=TEXT        speak a quoted text string
                        (reads from stdin if piped and no input flag is set)

Other:
  -h, --help            display this help and exit
  -v, --version         output version information and exit

Examples:
  ${PROGRAM_NAME} -c
  ${PROGRAM_NAME} -f notes.txt
  ${PROGRAM_NAME} -s "Hello world"
  echo "Hello from pipe" | ${PROGRAM_NAME}

Report bugs to: <https://github.com/galaxy-cli/ftts/issues>
EOF
}

die() {
    echo "${PROGRAM_NAME}: $*" >&2
    exit 1
}

pkg_for() {
    case "$1" in
        aplay)     echo "alsa-utils" ;;
        text2wave) echo "festival" ;;
        *)         echo "$1" ;;
    esac
}

check_deps() {
    local missing_cmds=() missing_pkgs=() cmd
    for cmd in "$@"; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            missing_cmds+=("$cmd")
            missing_pkgs+=("$(pkg_for "$cmd")")
        fi
    done

    if (( ${#missing_cmds[@]} > 0 )); then
        echo "${PROGRAM_NAME}: missing dependencies: ${missing_cmds[*]}" >&2
        read -rp "Install via apt? [Y/n] " yn
        if [[ "${yn:-Y}" =~ ^[Yy]$ ]]; then
            sudo apt install -y "${missing_pkgs[@]}" || exit 1
        else
            exit 1
        fi
    fi
}

# Emits:
#   <CLAUSE>  - brief breath after a clause break in a long chunk
#   <SENT>    - standard pause after a sentence or chunk
#   <PARA>    - longer pause at paragraph/blank-line boundaries
chunk_text() {
    awk '
    BEGIN {
        buf = ""
        soft_max = 160
        hard_max = 260
    }
    function emit_chunk(pause_tag) {
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", buf)
        gsub(/[[:space:]]+/, " ", buf)
        if (length(buf) > 0) {
            print buf
            if (pause_tag != "") {
                print pause_tag
            }
        }
        buf = ""
    }
    /^[[:space:]]*$/ {
        emit_chunk("<PARA>")
        next
    }
    {
        n = split($0, words, /[[:space:]]+/)
        for (i = 1; i <= n; i++) {
            w = words[i]
            if (w == "") continue

            if (w ~ /^[-=*_]{3,}$/) {
                emit_chunk("<PARA>")
                continue
            }

            buf = (buf == "" ? w : buf " " w)

            is_decimal = (w ~ /^[0-9]+\.[0-9]+$/)
            ends_sentence = (!is_decimal && w ~ /[.!?]["\x27\x22\)\]]*$/)
            ends_clause = (w ~ /[,;:—-]$/)

            if (ends_sentence && length(buf) >= 20) {
                emit_chunk("<SENT>")
            } else if (ends_clause && length(buf) >= soft_max) {
                emit_chunk("<CLAUSE>")
            } else if (length(buf) >= hard_max) {
                emit_chunk("<SENT>")
            }
        }
    }
    END {
        emit_chunk("")
    }'
}

append_pcm_silence() {
    local target_file="$1" ms="$2" rate="${3:-16000}"
    local bytes=$(( (rate * ms * 2) / 1000 ))
    (( bytes > 0 )) && head -c "$bytes" /dev/zero >> "$target_file"
}

play_silence_aplay() {
    local ms="$1" rate="${2:-16000}" raw_sil="$3"
    : > "$raw_sil"
    append_pcm_silence "$raw_sil" "$ms" "$rate"
    [[ -s "$raw_sil" ]] && aplay -q -t raw -f S16_LE -r "$rate" -c 1 "$raw_sil" 2>/dev/null
}

pause_ms_for_tag() {
    case "$1" in
        "<CLAUSE>") echo 90 ;;
        "<SENT>")   echo 180 ;;
        "<PARA>")   echo 420 ;;
        *)          echo 0 ;;
    esac
}

# --- ARGUMENT PARSING ---
input_source=""
file_path=""
text=""

set_source() {
    [[ -n "$input_source" ]] && die "multiple input sources specified"
    input_source="$1"
}

while [[ $# -gt 0 ]]; do
    opt="$1"
    has_inline_val=false
    inline_val=""

    if [[ "$opt" == --*=* ]]; then
        has_inline_val=true
        inline_val="${opt#*=}"
        opt="${opt%%=*}"
    fi

    case "$opt" in
        -c|--clipboard)
            $has_inline_val && die "option '$opt' doesn't allow an argument"
            set_source "clipboard"
            shift
            ;;
        -f|--file)
            set_source "file"
            if $has_inline_val; then
                file_path="$inline_val"; shift
            else
                (( $# < 2 )) || [[ "$2" == -* ]] && die "option requires an argument -- '$opt'"
                file_path="$2"; shift 2
            fi
            ;;
        -s|--say)
            set_source "string"
            if $has_inline_val; then
                text="$inline_val"; shift
            else
                (( $# < 2 )) || [[ "$2" == -* ]] && die "option requires an argument -- '$opt'"
                text="$2"; shift 2
            fi
            ;;
        -h|--help)
            usage; exit 0
            ;;
        -v|--version)
            echo "${PROGRAM_NAME} ${VERSION}"; exit 0
            ;;
        -*)
            die "unrecognized option '$1'"
            ;;
        *)
            [[ -n "$text" ]] && die "multi-word strings must be enclosed in double quotes"
            die "extra operand '$1'"
            ;;
    esac
done

# Default to stdin if piped and no flag given
if [[ -z "$input_source" ]]; then
    [[ ! -t 0 ]] && input_source="stdin" || die "no input source specified (try --help)"
fi

# --- SINGLE-PASS VALIDATION & DEPENDENCIES ---
deps=(text2wave aplay)
[[ "$input_source" == "clipboard" ]] && deps+=(xsel)
check_deps "${deps[@]}"

if [[ "$input_source" == "file" ]]; then
    [[ -f "$file_path" && -r "$file_path" ]] || die "${file_path}: cannot read file"
    [[ "${file_path,,}" == *.pdf ]] && die "${file_path}: PDFs not supported natively (pipe via pdftotext instead)"
    if head -c 4096 "$file_path" | grep -q $'\x00'; then
        die "${file_path}: binary file not supported"
    fi
fi

# --- SINGLE-PASS DATA EXTRACTION ---
case "$input_source" in
    clipboard) text="$(xsel -b 2>/dev/null)" ;;
    file)      text="$(<"$file_path")" ;;
    stdin)     text="$(cat)" ;;
    string)    ;;
esac
[[ -z "${text//[[:space:]]/}" ]] && die "input text is empty"

# --- TEMP FILES & CLEANUP ---
wav_segment=$(mktemp /tmp/ftts_seg.XXXXXX.wav)
silence_raw=$(mktemp /tmp/ftts_sil.XXXXXX.raw)
sample_rate=16000

cleanup() {
    rm -f "$wav_segment" "$silence_raw" 2>/dev/null
}
trap 'cleanup; echo -e "\n[Speech Interrupted]" >&2; exit 130' INT TERM
trap 'cleanup' EXIT

# --- SYNTHESIS LOOP ---
while IFS= read -r line; do
    [[ -z "$line" ]] && continue

    pause_ms=$(pause_ms_for_tag "$line")
    if (( pause_ms > 0 )); then
        if [[ "$line" == "<PARA>" ]]; then
            play_silence_aplay 220 "$sample_rate" "$silence_raw"
        fi
        continue
    fi

    if ! err=$(printf '%s\n' "$line" | text2wave -eval "(Parameter.set 'Duration_Stretch 0.6)" -o "$wav_segment" 2>&1) || [[ ! -s "$wav_segment" ]]; then
        echo "[!] Synthesis skipped: ${err%%$'\n'*}" >&2
        continue
    fi

    detected_rate=$(od -An -tu4 -j24 -N4 "$wav_segment" 2>/dev/null | tr -d ' ')
    [[ -n "$detected_rate" ]] && sample_rate="$detected_rate"

    aplay -q "$wav_segment" 2>/dev/null
done < <(printf '%s\n' "$text" | chunk_text)