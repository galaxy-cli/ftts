#!/bin/bash
#     __ _   _       
#    / _| |_| |_ ___ 
#   | |_| __| __/ __|
#   |  _| |_| |_\__ \
#   |_|  \__|\__|___/                 
#
# ftts - A professional text-to-speech engine wrapper for Festival with optional MP3 saving.
#
# Project: https://github.com

# --- PROGRAM CONFIGURATION ---
PROGRAM_NAME="${0##*/}"
VERSION="1.3.3"

# --- DEPENDENCY CHECK ---
missing=()
for cmd in festival xsel aplay; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        missing+=("$cmd")
    fi
done

if [ "${#missing[@]}" -gt 0 ]; then
    echo "${PROGRAM_NAME}: missing required dependencies: ${missing[*]}" >&2
    read -rp "Would you like to install them via apt? [Y/n] " yn
    yn=${yn:-Y}

    if [[ $yn =~ ^[Yy]$ ]]; then
        sudo apt update && sudo apt install -y "${missing[@]}"
    else
        echo "${PROGRAM_NAME}: cannot continue without required dependencies" >&2
        exit 1
    fi
fi

# --- USAGE ---
usage() {
    cat <<EOF
Usage: ${PROGRAM_NAME} [OPTION]... [FILE | TEXT]

Convert text to speech using the Festival engine with fluid sentence pacing.

Mandatory arguments to long options are mandatory for short options too.
  -c, --clipboard        read text directly from the system clipboard
  -f, --file=FILE        read text from specified plaintext FILE
  -s, --speak=TEXT       speak the provided quoted string of TEXT
  -o, --output=OUT_FILE  save the generated speech as an MP3 audio file
      --help             display this help and exit
  -v, --version          output version information and exit

Examples:
  ${PROGRAM_NAME} -c
  ${PROGRAM_NAME} -f document.txt -o notebook.mp3
  ${PROGRAM_NAME} -s "Hello world"

Report bugs to: <207926666+galaxy-cli@://github.com>
EOF
}

# --- VERSION ---
show_version() {
    cat <<EOF
${PROGRAM_NAME} ${VERSION}
EOF
}

# --- INITIALIZE ---
input_source=""
file_path=""
output_file=""
text=""

# --- ARGUMENT PARSING ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--clipboard)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            input_source="clipboard"
            shift
            ;;
        -f|--file)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'f'" >&2; exit 1; }
            input_source="file"
            file_path="$2"
            shift 2
            ;;
        -s|--speak)
            [[ -n "$input_source" ]] && { echo "${PROGRAM_NAME}: multiple input sources specified" >&2; exit 1; }
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 's'" >&2; exit 1; }
            input_source="string"
            text="$2"
            shift 2
            ;;
        -o|--output)
            [[ -z "$2" || "$2" == -* ]] && { echo "${PROGRAM_NAME}: option requires an argument -- 'o'" >&2; exit 1; }
            output_file="$2"
            shift 2
            ;;
        --help)
            usage
            exit 0
            ;;
        -v|--version)
            show_version
            exit 0
            ;;
        -*)
            echo "${PROGRAM_NAME}: unrecognized option '$1'" >&2
            echo "Try '${PROGRAM_NAME} --help' for more information" >&2
            exit 1
            ;;
        *)
            if [[ -n "$text" ]]; then
                echo "${PROGRAM_NAME}: multi-word strings must be enclosed in double quotes" >&2
                echo "Try '${PROGRAM_NAME} -s \"hello world\"'" >&2
                exit 1
            fi
            echo "${PROGRAM_NAME}: extra operand '$1'" >&2
            echo "Try '${PROGRAM_NAME} --help' for more information" >&2
            exit 1
            ;;
    esac
done

# --- VALIDATION ---
if [[ -z "$input_source" ]]; then
    echo "${PROGRAM_NAME}: no input source specified" >&2
    echo "Try '${PROGRAM_NAME} --help' for more information" >&2
    exit 1
fi

if [[ "$input_source" == "file" ]]; then
    if [[ ! -e "$file_path" ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: No such file or directory" >&2
        exit 1
    elif [[ ! -f "$file_path" ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: Not a regular file" >&2
        exit 1
    elif [[ ! -r "$file_path" ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: Permission denied" >&2
        exit 1
    elif [[ $(file -b --mime-type "$file_path") != text/* ]]; then
        echo "${PROGRAM_NAME}: ${file_path}: Not a plaintext file" >&2
        exit 1
    fi
fi

# --- CONDITIONAL DEPENDENCY & PATH CHECK FOR MP3 ---
if [[ -n "$output_file" ]]; then
    if ! command -v lame >/dev/null 2>&1; then
        echo "${PROGRAM_NAME}: saving to MP3 requires 'lame'. Please install it via apt." >&2
        exit 1
    fi
    [[ "$output_file" != *.mp3 ]] && output_file="${output_file}.mp3"
    
    output_dir=$(dirname "$output_file")
    if [[ ! -d "$output_dir" ]]; then
        echo "${PROGRAM_NAME}: ${output_dir}: No such directory" >&2
        exit 1
    elif [[ ! -w "$output_dir" ]]; then
        echo "${PROGRAM_NAME}: ${output_dir}: Permission denied" >&2
        exit 1
    fi

    > "$output_file"
fi

# --- DATA EXTRACTION ---
case "$input_source" in
    clipboard)
        text="$(xsel -b 2>/dev/null)"
        if [[ -z "${text//[:space:]/}" ]]; then
            echo "${PROGRAM_NAME}: clipboard is empty" >&2
            exit 1
        fi
        ;;
    file)
        text="$(cat "$file_path")"
        if [[ -z "${text//[:space:]/}" ]]; then
            echo "${PROGRAM_NAME}: ${file_path}: File is empty" >&2
            exit 1
        fi
        ;;
    string)
        ;;
    *)
        echo "${PROGRAM_NAME}: invalid internal input configuration" >&2
        exit 1
        ;;
esac

# --- COMPONENT SETUP ---
wav_segment=$(mktemp /tmp/ftts_seg.XXXXXX.wav)

# --- CLEAN EXIT TRAP ---
cleanup() {
    pkill -P $$ festival lame aplay 2>/dev/null
    rm -f "$wav_segment" 2>/dev/null
}
trap 'cleanup; echo -e "\n[Speech Interrupted]"; exit 0' SIGINT SIGTERM
trap 'cleanup' EXIT

# --- STREAMED SENTENCE EXECUTION ---
while read -r sentence; do
    [[ -z "${sentence//[:space:]/}" ]] && continue

    escaped_sentence=$(printf '%s' "$sentence" | sed 's/"/\\"/g')
    
    festival -b \
        "(Parameter.set 'Duration_Stretch 0.7)" \
        "(set! myutt (Utterance Text \"$escaped_sentence\"))" \
        "(utt.synth myutt)" \
        "(utt.save.wave myutt \"$wav_segment\")" &>/dev/null

    if [[ -f "$wav_segment" && -s "$wav_segment" ]]; then
        if [[ -n "$output_file" ]]; then
            aplay "$wav_segment" 2>/dev/null &
            APLAY_PID=$!
            lame --preset standard "$wav_segment" - >> "$output_file" 2>/dev/null
            wait $APLAY_PID 2>/dev/null
        else
            aplay "$wav_segment" 2>/dev/null
        fi
        rm -f "$wav_segment"
    fi
done < <(printf '%s\n' "$text" | awk 'BEGIN { RS="[ \t\n]+" } { printf "%s ", $0; if ($0 ~ /[.?!]["\x27\x22]*$/) { printf "\n" } } END { printf "\n" }')